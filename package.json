{
  "name": "playtree",
  "private": true,
  "version": "1.0.0",
  "description": "PlayTree™ by GoStudios - the interactive home of the PlayTree gaming universe. Copyright (c) 2026 GoStudios. All rights reserved.",
  "author": "GoStudios",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist:win": "vite build && node scripts/dist-win.cjs",
    "cap:sync": "vite build && cap sync android",
    "apk:debug": "vite build && cap sync android && cd android && gradlew.bat assembleDebug",
    "apk:release": "vite build && cap sync android && cd android && gradlew.bat assembleRelease",
    "test:e2e": "vite build && node tests/e2e.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.63.0",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.gostudios.playtree",
    "productName": "PlayTree",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PlayTree"
    }
  }
}
